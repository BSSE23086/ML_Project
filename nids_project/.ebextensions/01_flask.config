# .ebextensions/01_flask.config
# AWS Elastic Beanstalk environment configuration
# Automatically runs after each deployment

option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: app:app
  aws:elasticbeanstalk:application:environment:
    FLASK_ENV: production
    PYTHONUNBUFFERED: "1"
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static

# Create required directories on the EC2 instance
container_commands:
  01_create_dirs:
    command: "mkdir -p /var/app/current/models /var/app/current/data"
  02_permissions:
    command: "chmod 755 /var/app/current/models /var/app/current/data"
